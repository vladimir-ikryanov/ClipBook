    "When off, the history window stays visible to you but is hidden from screen sharing, screen recordings and screenshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, bleibt das Verlaufsfenster für dich sichtbar, wird aber in Bildschirmfreigaben, Bildschirmaufnahmen und Bildschirmfotos ausgeblendet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the history window stays visible to you but is hidden from screen sharing, screen recordings and screenshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, la ventana de historial sigue visible para ti, pero se oculta al compartir la pantalla, en las grabaciones de pantalla y en las capturas de pantalla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, la finestra cronologia resta visibile a te ma viene nascosta nella condivisione dello schermo, nelle registrazioni dello schermo e negli screenshot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、履歴ウィンドウは自分には表示されますが、画面共有、画面収録、スクリーンショットには表示されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, a janela de histórico continua visível para você, mas fica oculta no compartilhamento de tela, nas gravações de tela e nas capturas de tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，历史窗口对你仍然可见，但不会出现在屏幕共享、屏幕录制和截屏中。"
          }
        }
      }
    },
