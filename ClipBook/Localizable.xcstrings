  "strings" : {
    "" : {

    },
    " of ClipBook. To continue using ClipBook, please purchase a license key from online store and activate it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " von ClipBook. Um ClipBook weiter zu verwenden, kaufe bitte einen Lizenzschlüssel im Online-Store und aktiviere ihn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " of ClipBook. To continue using ClipBook, please purchase a licence key from the online store and activate it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " de ClipBook. Para seguir usando ClipBook, compra una clave de licencia en la tienda en línea y actívala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " di ClipBook. Per continuare a usare ClipBook, acquista una chiave di licenza nello store online e attivala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "のClipBookを使用しています。ClipBookを引き続き使用するには、オンラインストアでライセンスキーを購入して有効化してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " do ClipBook. Para continuar usando o ClipBook, compre uma chave de licença na loja online e ative-a."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "的 ClipBook。若要继续使用 ClipBook，请从在线商店购买许可证密钥并激活。"
          }
        }
      }
    },
    "%@ days left in your trial" : {
