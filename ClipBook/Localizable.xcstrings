    "Mask passwords, API keys, access tokens and card numbers in copied text. Pasting and copying still use the original text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskiert Passwörter, API-Schlüssel, Zugriffstoken und Kartennummern in kopiertem Text. Beim Einfügen und Kopieren wird weiterhin der ursprüngliche Text verwendet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mask passwords, API keys, access tokens and card numbers in copied text. Pasting and copying still use the original text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta contraseñas, claves de API, tokens de acceso y números de tarjeta en el texto copiado. Al pegar y copiar se sigue usando el texto original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maschera password, chiavi API, token di accesso e numeri di carta nel testo copiato. Incolla e copia usano comunque il testo originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしたテキストに含まれるパスワード、APIキー、アクセストークン、カード番号をマスクします。ペーストとコピーには元のテキストが使われます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mascara senhas, chaves de API, tokens de acesso e números de cartão no texto copiado. Colar e copiar continuam usando o texto original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮盖所拷贝文本中的密码、API 密钥、访问令牌和卡号。粘贴和拷贝仍使用原始文本。"
          }
        }
      }
    },
