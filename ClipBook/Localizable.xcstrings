    "Show the type, size, source, and copy dates of the selected item under its preview, or on their own while the preview is hidden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Typ, Größe, Quelle und Kopierdaten des ausgewählten Eintrags unter seiner Vorschau oder für sich allein, solange die Vorschau ausgeblendet ist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the type, size, source, and copy dates of the selected item under its preview, or on their own while the preview is hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el tipo, el tamaño, el origen y las fechas de copia del elemento seleccionado debajo de su vista previa, o solos mientras la vista previa está oculta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra tipo, dimensione, origine e date di copia dell'elemento selezionato sotto la sua anteprima, oppure da soli quando l'anteprima è nascosta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した項目の種類、サイズ、コピー元、コピー日時をプレビューの下に表示します。プレビューを非表示にしている間は詳細だけを表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o tipo, o tamanho, a origem e as datas de cópia do item selecionado abaixo da pré-visualização, ou sozinhos enquanto a pré-visualização estiver oculta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所选项目的预览下方显示其类型、大小、来源和复制日期；隐藏预览时单独显示这些信息。"
          }
        }
      }
    },
    "Some imported items are older than the history limit. Do you want to keep them?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige importierte Objekte sind älter als das Verlaufslimit. Möchtest du sie behalten?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some imported items are older than the history limit. Do you want to keep them?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos elementos importados son más antiguos que el límite del historial. ¿Quieres conservarlos?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni elementi importati sono più vecchi del limite della cronologia. Vuoi conservarli?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込んだアイテムの一部が履歴の保持期間より古くなっています。保持しますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
