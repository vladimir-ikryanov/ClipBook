    "Select how long to keep individual history items. Items older than this period will be automatically removed from the history. Choose Never to stop capturing a type of content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange einzelne Verlaufsobjekte behalten werden. Objekte, die älter als dieser Zeitraum sind, werden automatisch aus dem Verlauf entfernt. Wähle „Nie“, um einen Inhaltstyp nicht mehr zu erfassen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select how long to keep individual history items. Items older than this period will be automatically removed from the history. Choose Never to stop capturing a type of content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione cuánto tiempo desea conservar los elementos individuales del historial. Los elementos anteriores a este período se eliminarán automáticamente del historial. Elija Nunca para dejar de capturar un tipo de contenido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona per quanto tempo conservare i singoli elementi della cronologia. Gli elementi più vecchi di questo periodo verranno rimossi automaticamente dalla cronologia. Scegli Mai per non acquisire più un tipo di contenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個々の履歴アイテムを保存する期間を選択します。この期間より古いアイテムは履歴から自動的に削除されます。「保存しない」を選ぶと、そのタイプのコンテンツはキャプチャされなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione por quanto tempo manter itens individuais do histórico. Itens anteriores a esse período serão automaticamente removidos do histórico. Escolha Nunca para parar de capturar um tipo de conteúdo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择保留各个历史记录项目的时间。早于该时间段的项目将自动从历史记录中删除。选择“从不”可停止捕获某种类型的内容。"
          }
        }
      }
    },
