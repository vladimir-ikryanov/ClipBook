    "Your history is kept and stays visible in read-only mode. Activate a license to copy, paste and edit your items again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verlauf bleibt erhalten und ist schreibgeschützt weiterhin sichtbar. Aktiviere eine Lizenz, um deine Einträge wieder zu kopieren, einzufügen und zu bearbeiten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your history is kept and stays visible in read-only mode. Activate a licence to copy, paste and edit your items again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial se conserva y sigue visible en modo de solo lectura. Activa una licencia para volver a copiar, pegar y editar tus elementos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cronologia viene conservata e resta visibile in sola lettura. Attiva una licenza per copiare, incollare e modificare di nuovo i tuoi elementi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴は保持され、読み取り専用モードで引き続き表示されます。ライセンスを有効化すると、項目のコピー、ペースト、編集が再びできるようになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico é mantido e continua visível no modo somente leitura. Ative uma licença para voltar a copiar, colar e editar seus itens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的历史记录会被保留，并以只读模式继续显示。激活许可证即可再次复制、粘贴和编辑这些项目。"
          }
        }
      }
    },
    "Your trial ended a week ago, and your clipboard history is still here, waiting. Use this code at checkout to get %@ off a license." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Testversion ist vor einer Woche abgelaufen, und dein Zwischenablageverlauf wartet noch auf dich. Gib diesen Code beim Kauf ein, um %@ Rabatt auf eine Lizenz zu erhalten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your trial ended a week ago, and your clipboard history is still here, waiting. Use this code at checkout to get %@ off a licence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba terminó hace una semana y tu historial del portapapeles sigue aquí, esperándote. Usa este código al pagar para obtener un %@ de descuento en una licencia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua prova è terminata una settimana fa e la cronologia degli appunti è ancora qui ad aspettarti. Usa questo codice al momento del pagamento per avere il %@ di sconto su una licenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トライアルが終了して1週間が経ちましたが、クリップボード履歴はそのまま残っています。購入時にこのコードを使うと、ライセンスが%@オフになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu período de teste terminou há uma semana, e seu histórico da área de transferência continua aqui, esperando por você. Use este código na finalização da compra para ganhar %@ de desconto em uma licença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的试用已于一周前结束，但剪贴板历史记录仍在这里等着你。结账时使用此优惠码，购买许可证可享 %@ 折扣。"
          }
        }
      }
    },
