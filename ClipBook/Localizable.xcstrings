    "All history items except favorites and tagged items will be moved to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Verlaufsobjekte außer Favoriten und markierten Objekten werden in den Papierkorb gelegt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All history items except favourites and tagged items will be moved to the Bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos del historial, excepto los favoritos y los etiquetados, se moverán a la papelera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli elementi della cronologia, tranne i preferiti e quelli con tag, verranno spostati nel cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りとタグ付きの項目を除くすべての履歴項目がゴミ箱に移動されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os itens do histórico, exceto favoritos e itens com tags, serão movidos para a Lixeira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除个人收藏和带标签的项目外，所有历史记录项目都将被移到废纸篓。"
          }
        }
      }
    },
    "All history items including favorites and tagged items will be moved to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Verlaufsobjekte einschließlich Favoriten und markierter Objekte werden in den Papierkorb gelegt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
