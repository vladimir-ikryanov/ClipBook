    "Display a confirmation dialog when clearing history manually using the 'Delete All' command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Bestätigungsdialog anzeigen, wenn der Verlauf manuell mit dem Befehl „Alle löschen“ gelöscht wird."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display a confirmation dialogue when clearing history manually using the 'Delete All' command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un cuadro de diálogo de confirmación al borrar el historial manualmente usando el comando \"Eliminar todo\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una finestra di conferma quando cancelli manualmente la cronologia con il comando \"Elimina tutto\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すべて削除」コマンドを使用して履歴を手動でクリアするときに、確認ダイアログを表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiba uma caixa de diálogo de confirmação ao limpar o histórico manualmente usando o comando 'Excluir tudo'."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“全部删除”命令手动清除历史记录时显示确认对话框。"
          }
        }
      }
    },
    "Display the ClipBook app icon in the menu bar. You can always open Settings by pressing ⌘ + , inside the clipboard history window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ClipBook-App-Symbol in der Menüleiste anzeigen. Du kannst die Einstellungen im Zwischenablage-Verlaufsfenster jederzeit mit ⌘ + , öffnen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display the ClipBook app icon in the menu bar. You can always open Settings by pressing ⌘ + , inside the clipboard history window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestre el ícono de la aplicación ClipBook en la barra de menú. Siempre puedes abrir Configuración presionando ⌘ +, dentro de la ventana del historial del portapapeles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーにClipBookアプリアイコンを表示します。クリップボード履歴ウィンドウ内で ⌘ + を押すと、いつでも設定を開くことができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiba o ícone do aplicativo ClipBook na barra de menu. Você sempre pode abrir Configurações pressionando ⌘ +, dentro da janela do histórico da área de transferência."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏中显示 ClipBook 应用程序图标。您始终可以通过在剪贴板历史记录窗口中按 ⌘ + 打开“设置”。"
          }
        }
      }
    },
    "Do not capture clipboard changes while these apps are active. Adding an app offers to delete the items already copied from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischenablageänderungen nicht erfassen, solange diese Apps aktiv sind. Beim Hinzufügen einer App wird angeboten, die bereits daraus kopierten Objekte zu löschen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not capture clipboard changes while these apps are active. Adding an app offers to delete the items already copied from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No capture los cambios del portapapeles mientras estas aplicaciones estén activas. Al añadir una aplicación se ofrece eliminar los elementos ya copiados desde ella."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non acquisire modifiche agli appunti mentre queste app sono attive. Aggiungendo un'app viene proposto di eliminare gli elementi già copiati da essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアプリがアクティブな間は、クリップボードの変更をキャプチャしないでください。アプリを追加すると、そのアプリからすでにコピーされたアイテムの削除を提案します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não capture alterações na área de transferência enquanto esses aplicativos estiverem ativos. Ao adicionar um aplicativo, será oferecido excluir os itens já copiados dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当这些应用程序处于活动状态时，请勿捕获剪贴板更改。添加应用程序时，会提示删除已从该应用程序复制的项目。"
          }
        }
      }
    },
