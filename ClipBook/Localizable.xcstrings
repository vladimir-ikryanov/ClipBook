    "Keep everything you copy and quickly access your\nclipboard history whenever you need it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre alles auf, was du kopierst, und greife schnell auf deinen\nZwischenablageverlauf zu, wann immer du ihn brauchst."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep everything you copy and quickly access your\nclipboard history whenever you need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todo lo que copias y accede rápidamente a tu\nhistorial del portapapeles cuando lo necesites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva tutto ciò che copi e accedi rapidamente alla\ncronologia degli appunti quando ti serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしたものをすべて保存し、必要なときに\nクリップボード履歴へすばやくアクセスできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde tudo o que você copia e acesse rapidamente seu\nhistórico da área de transferência sempre que precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存你复制的所有内容，并在需要时快速访问\n剪贴板历史记录。"
          }
        }
      }
    },
