    "ClipBook Activation Error" : {
      "comment" : "Subject line of an email to support@clipbook.app for help with activating ClipBook.",
      "isCommentAutoGenerated" : true
    },
    "ClipBook archive version %d is not supported." : {
      "comment" : "A description of an error that might occur when importing a ClipBook archive. The argument is the version number of the archive.",
      "isCommentAutoGenerated" : true
    },
    "ClipBook is now watching your clipboard. Copy something, open history, and paste it back whenever you need it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook überwacht jetzt deine Zwischenablage. Kopiere etwas, öffne den Verlauf und füge es bei Bedarf wieder ein."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook is now watching your clipboard. Copy something, open history, and paste it back whenever you need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook ahora vigila tu portapapeles. Copia algo, abre el historial y pégalo cuando lo necesites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook ora controlla i tuoi appunti. Copia qualcosa, apri la cronologia e incollalo quando ti serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook がクリップボードを監視しています。何かをコピーし、履歴を開いて、必要なときに貼り付けましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ClipBook agora está monitorando sua área de transferência. Copie algo, abra o histórico e cole quando precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook 现在正在监视你的剪贴板。复制内容、打开历史记录，并在需要时粘贴回来。"
          }
        }
      }
    },
    "ClipBook needs Accessibility permission to paste into the previously active app." : {
      "comment" : "Alert message when the user does not have Accessibility permission to paste into the previously active app.",
      "isCommentAutoGenerated" : true
    },
    "ClipBook won't save what you copy until you open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook speichert nichts, was du kopierst, bis du es wieder öffnest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook won't save what you copy until you open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook no guardará lo que copies hasta que vuelvas a abrirlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBook non salverà ciò che copi finché non lo riapri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBookを再度開くまで、コピーした内容は保存されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
