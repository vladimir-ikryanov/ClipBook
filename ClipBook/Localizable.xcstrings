    "I hope you enjoyed using ClipBook. If you like it, please consider supporting the development by purchasing a license." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hoffe, ClipBook hat dir gefallen. Wenn ja, unterstütze die Entwicklung bitte mit dem Kauf einer Lizenz."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hope you enjoyed using ClipBook. If you like it, please consider supporting the development by purchasing a licence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espero que hayas disfrutado usando ClipBook. Si te gusta, considera apoyar su desarrollo comprando una licencia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spero che ClipBook ti sia piaciuto. Se ti piace, considera di sostenerne lo sviluppo acquistando una licenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipBookをお楽しみいただけたなら幸いです。気に入っていただけたら、ライセンスを購入して開発を支援していただけると嬉しいです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espero que você tenha gostado de usar o ClipBook. Se gostou, considere apoiar o desenvolvimento comprando uma licença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希望你喜欢使用 ClipBook。如果喜欢，请考虑购买许可证来支持它的开发。"
          }
        }
      }
    },
    "If you don't like it, please let me know why." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls nicht, lass mich bitte wissen, warum."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
